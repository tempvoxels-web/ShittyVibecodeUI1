local function MakeDraggable(dragHandle, target)
	local dragging = false
	local dragInputType
	local dragStart
	local startPos

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragInputType = input.UserInputType
			dragStart = input.Position
			startPos = target.Position
		end
	end)

	dragHandle.InputEnded:Connect(function(input)
		if input.UserInputType == dragInputType then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function NormalizeKeyName(key)
	if typeof(key) == "EnumItem" then
		return key.Name
	end
	return key
end

local function ResolveKeybindConfig(config)
	local raw = config.CurrentKeybind
		or config.Keybind
		or config.KeyCode
		or config.Key
		or config.Default
	return NormalizeKeyName(raw)
end

local function BindKeybindCapture(textBox, currentKeybind, onChanged)
	textBox.Text = NormalizeKeyName(currentKeybind) or ""

	local listening = false
	local inputConnection

	textBox.Focused:Connect(function()
		textBox.Text = ""
		listening = true

		if inputConnection then
			inputConnection:Disconnect()
		end

		inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
			if not listening then
				return
			end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local keyName = input.KeyCode.Name:upper()
				textBox.Text = keyName
				listening = false
				textBox:ReleaseFocus()
				onChanged(keyName)
			end
		end)
	end)

	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		if not listening then
			return
		end
		if textBox.Text ~= "" then
			local keyName = textBox.Text:upper()
			textBox.Text = keyName
			listening = false
			textBox:ReleaseFocus()
			onChanged(keyName)
		end
	end)

	textBox.FocusLost:Connect(function()
		listening = false
		if textBox.Text == "" then
			textBox.Text = NormalizeKeyName(currentKeybind) or ""
		end
		if inputConnection then
			inputConnection:Disconnect()
			inputConnection = nil
		end
	end)
end

