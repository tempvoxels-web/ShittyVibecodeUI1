function Tab:CreateDropdown(config)
	config = config or {}
	local name = config.Name or "Dropdown"
	local options = config.Options or {}
	local default = config.CurrentOption or options[1] or ""
	local callback = config.Callback or function() end

	local clone = self.Window.Templates.DropdownTemplate:Clone()
	clone.Parent = self.Page
	clone.Text = name
	clone.LayoutOrder = NextOrderFor(self.Page)

	local box = clone:FindFirstChild("DropdownBox")
	local arrow = box:FindFirstChild("DropdownArrow")
	local list = box:FindFirstChild("DropdownList")
	local optionTemplate = self.Window.Templates.DropdownOptionTemplate

	local current = default
	local open = false

	local function SetText()
		box.Text = tostring(current)
	end
	SetText()

	local optionButtons = {}

	local function CloseList()
		open = false
		list.Visible = false
		arrow.Text = "v"
	end

	local function OpenList()
		open = true
		list.Visible = true
		arrow.Text = "^"
	end

	local function SelectOption(value)
		current = value
		SetText()
		CloseList()
		callback(current)
	end

	local function RebuildOptions(newOptions)
		for _, btn in ipairs(optionButtons) do
			btn:Destroy()
		end
		optionButtons = {}

		for i, optionValue in ipairs(newOptions) do
			local optClone = optionTemplate:Clone()
			optClone.Text = tostring(optionValue)
			optClone.LayoutOrder = i
			optClone.Parent = list

			optClone.MouseButton1Click:Connect(function()
				SelectOption(optionValue)
			end)

			table.insert(optionButtons, optClone)
		end

		list.Size = UDim2.new(1, 0, 0, #newOptions * 20)
	end

	RebuildOptions(options)

	box.MouseButton1Click:Connect(function()
		if open then
			CloseList()
		else
			OpenList()
		end
	end)

	callback(current)

	local dropdownObj = {}
	function dropdownObj:Set(value)
		current = value
		SetText()
		callback(current)
	end
	function dropdownObj:Get()
		return current
	end
	function dropdownObj:Refresh(newOptions, newDefault)
		options = newOptions or options
		RebuildOptions(options)
		if newDefault ~= nil then
			current = newDefault
			SetText()
		end
	end

	return dropdownObj
end

return Library
