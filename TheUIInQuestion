local function MakeDraggable(dragHandle, target)
	local dragging = false
	local dragInputType
	local dragStart
	local startPos

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragInputType = input.UserInputType
			dragStart = input.Position
			startPos = target.Position
		end
	end)

	dragHandle.InputEnded:Connect(function(input)
		if input.UserInputType == dragInputType then
			dragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			target.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function BindKeybindCapture(textBox, currentKeybind, onChanged)
	textBox.Text = currentKeybind or ""

	local listening = false
	local inputConnection

	textBox.Focused:Connect(function()
		textBox.Text = ""
		listening = true

		if inputConnection then
			inputConnection:Disconnect()
		end

		inputConnection = UserInputService.InputBegan:Connect(function(input, processed)
			if not listening then
				return
			end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local keyName = input.KeyCode.Name:upper()
				textBox.Text = keyName
				listening = false
				textBox:ReleaseFocus()
				onChanged(keyName)
			end
		end)
	end)

	textBox:GetPropertyChangedSignal("Text"):Connect(function()
		if not listening then
			return
		end
		if textBox.Text ~= "" then
			local keyName = textBox.Text:upper()
			textBox.Text = keyName
			listening = false
			textBox:ReleaseFocus()
			onChanged(keyName)
		end
	end)

	textBox.FocusLost:Connect(function()
		listening = false
		if textBox.Text == "" then
			textBox.Text = currentKeybind or ""
		end
		if inputConnection then
			inputConnection:Disconnect()
			inputConnection = nil
		end
	end)
end

local Window = {}
Window.__index = Window

function Library:CreateWindow(config)
	config = config or {}

	if config.Name then
		Header.Text = config.Name
	end

	local toggleKeybind = config.ToggleKeybind or Enum.KeyCode.RightShift

	if config.Parent then
		local targetParent

		if typeof(config.Parent) == "Instance" then
			targetParent = config.Parent
		elseif config.Parent == "PlayerGui" then
			targetParent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
		elseif config.Parent == "CoreGui" then
			local success, coreGui = pcall(function()
				return game:GetService("CoreGui")
			end)
			if success then
				targetParent = coreGui
			end
		end

		if targetParent then
			VoxelsUI.Parent = targetParent
		end
	end

	local self = setmetatable({}, Window)
	self.Tabs = {}
	self.CurrentTab = nil
	self.TabButtons = {}

	MakeDraggable(TopBar, MainFrame)

	local minimized = false
	local expandedSize = MainFrame.Size
	local collapsedSize = UDim2.new(expandedSize.X.Scale, expandedSize.X.Offset, 0, TopBar.Size.Y.Offset)

	local function SetMinimized(value)
		minimized = value
		Box.Visible = not minimized
		TabSection.Visible = not minimized
		MainFrame.Size = minimized and collapsedSize or expandedSize
	end

	MinimizeButton.MouseButton1Click:Connect(function()
		SetMinimized(not minimized)
	end)

	ExitButton.MouseButton1Click:Connect(function()
		VoxelsUI.Enabled = false
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard
			and input.KeyCode == toggleKeybind then
			VoxelsUI.Enabled = not VoxelsUI.Enabled
		end
	end)

	return self
end

local Tab = {}
Tab.__index = Tab

function Window:CreateTab(name)
	name = name or "Tab"

	local isFirstTab = (#self.Tabs == 0)

	local page
	if isFirstTab then
		page = Box1
	else
		page = Templates.TabListTemplate:Clone()
		page.Parent = Box
		page.Visible = false
	end

	local tabButton
	if isFirstTab then
		tabButton = MainTabButton
		MainTabButton.Text = name
	else
		tabButton = Templates.TabButtonTemplate:Clone()
		tabButton.Text = name
		tabButton.Parent = TabList
	end

	local tabObj = setmetatable({}, Tab)
	tabObj.Page = page
	tabObj.Button = tabButton
	tabObj.Window = self

	tabButton.MouseButton1Click:Connect(function()
		self:SelectTab(tabObj)
	end)

	table.insert(self.Tabs, tabObj)

	if isFirstTab then
		self.CurrentTab = tabObj
		tabButton.BackgroundColor3 = Color3.fromRGB(90, 90, 90)
	end

	return tabObj
end

function Window:SelectTab(tabObj)
	for _, t in ipairs(self.Tabs) do
		t.Page.Visible = (t == tabObj)
		t.Button.BackgroundColor3 = (t == tabObj)
			and Color3.fromRGB(90, 90, 90)
			or Color3.fromRGB(70, 70, 70)
	end
	self.CurrentTab = tabObj
end

function Tab:CreateToggle(config)
	config = config or {}
	local name = config.Name or "Toggle"
	local default = config.CurrentValue or false
	local callback = config.Callback or function() end

	local clone = Templates.ToggleTemplate:Clone()
	clone.Parent = self.Page

	local label = clone:FindFirstChild("TextLabel")
	local indicator = clone:FindFirstChild("ToggleIndicator")

	label.Text = name

	local toggled = default

	local onColor = Color3.fromRGB(60, 160, 90)
	local offColor = Color3.fromRGB(90, 90, 90)

	local function Render()
		indicator.BackgroundColor3 = toggled and onColor or offColor
	end
	Render()

	clone.MouseButton1Click:Connect(function()
		toggled = not toggled
		Render()
		callback(toggled)
	end)

	callback(toggled)

	local toggleObj = {}
	function toggleObj:Set(value)
		toggled = value
		Render()
		callback(toggled)
	end
	function toggleObj:Get()
		return toggled
	end

	return toggleObj
end

function Tab:CreateButton(config)
	config = config or {}
	local name = config.Name or "Button"
	local callback = config.Callback or function() end

	local clone = Templates.ButtonTemplate:Clone()
	clone.Parent = self.Page
	clone.Text = name

	clone.MouseButton1Click:Connect(function()
		callback()
	end)

	return clone
end

function Tab:CreateKeybind(config)
	config = config or {}
	local name = config.Name or "Keybind"
	local defaultKeybind = config.CurrentKeybind or "E"
	local callback = config.Callback or function() end

	local clone = Templates.KeybindTemplate:Clone()
	clone.Parent = self.Page
	clone.Text = name

	local keybindBox = clone:FindFirstChild("TextBox")
	keybindBox.Selectable = true

	local currentKey = defaultKeybind

	BindKeybindCapture(keybindBox, currentKey, function(newKey)
		currentKey = newKey
		callback(currentKey)
	end)

	callback(currentKey)

	local keybindObj = {}
	function keybindObj:Set(key)
		currentKey = key
		keybindBox.Text = key
		callback(currentKey)
	end
	function keybindObj:Get()
		return currentKey
	end

	return keybindObj
end

function Tab:CreateKeybindToggle(config)
	config = config or {}
	local name = config.Name or "Toggle"
	local default = config.CurrentValue or false
	local defaultKeybind = config.CurrentKeybind or "E"
	local callback = config.Callback or function() end

	local clone = Templates.KeybindToggleTemplate:Clone()
	clone.Parent = self.Page

	local label = clone:FindFirstChild("TextLabel")
	local indicator = clone:FindFirstChild("KeybindToggleIndicator")
	local keybindBox = clone:FindFirstChild("TextBox")
	keybindBox.Selectable = true

	label.Text = name

	local toggled = default
	local currentKey = defaultKeybind

	local onColor = Color3.fromRGB(60, 160, 90)
	local offColor = Color3.fromRGB(90, 90, 90)

	local function Render()
		indicator.BackgroundColor3 = toggled and onColor or offColor
	end
	Render()

	local function Flip()
		toggled = not toggled
		Render()
		callback(toggled)
	end

	clone.MouseButton1Click:Connect(Flip)

	BindKeybindCapture(keybindBox, currentKey, function(newKey)
		currentKey = newKey
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.Keyboard
			and input.KeyCode.Name == currentKey then
			Flip()
		end
	end)

	callback(toggled)

	local toggleObj = {}
	function toggleObj:Set(value)
		toggled = value
		Render()
		callback(toggled)
	end
	function toggleObj:Get()
		return toggled
	end
	function toggleObj:SetKeybind(key)
		currentKey = key
		keybindBox.Text = key
	end

	return toggleObj
end

function Tab:CreateInput(config)
	config = config or {}
	local name = config.Name or "Input"
	local placeholder = config.PlaceholderText or "input"
	local default = config.DefaultText or ""
	local callback = config.Callback or function() end

	local clone = Templates.InputTemplate:Clone()
	clone.Parent = self.Page
	clone.Text = name

	local inputBox = clone:FindFirstChild("TextBox")
	inputBox.Selectable = true
	inputBox.PlaceholderText = placeholder
	inputBox.Text = default

	inputBox.FocusLost:Connect(function(enterPressed)
		callback(inputBox.Text)
	end)

	local inputObj = {}
	function inputObj:Set(text)
		inputBox.Text = text
		callback(text)
	end
	function inputObj:Get()
		return inputBox.Text
	end

	return inputObj
end

return Library
